# ===== App Ports =====
BACKEND_PORT=8080
FRONTEND_PORT=8081

# ===== PostgreSQL =====
POSTGRES_USER=spoont
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=spoont
POSTGRES_PORT=5433
DATABASE_URL=postgresql://spoont:replace-with-a-long-random-password@localhost:5433/spoont
JWT_SECRET=replace-with-at-least-32-random-characters

# ===== Local LLM / Event Discovery =====
# バックエンドをホストで動かす場合は http://127.0.0.1:11434 を指定する
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=gemma4:e2b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0
TRANSIT_API_BASE_URL=https://api.transit.ls8h.com
EVENT_SEARCH_JOB_TIMEOUT_MS=120000
EVENT_PAGE_TIMEOUT_MS=5000
EVENT_SEARCH_CACHE_TTL_MS=900000
EVENT_SEARCH_DEBUG_TIMINGS=false

# ===== Frontend / Expo =====
# スマホ実機で確認する場合は、自分のPCのローカルIPに変更する
LOCAL_IP=192.168.x.x
EXPO_PUBLIC_API_URL=http://192.168.x.x:8080
