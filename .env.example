# ===== App Ports =====
BACKEND_PORT=8080
FRONTEND_PORT=8081

# ===== PostgreSQL =====
POSTGRES_USER=spoont
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=spoont
POSTGRES_PORT=5433
DATABASE_URL=postgresql://spoont:replace-with-a-long-random-password@localhost:5433/spoont
JWT_SECRET=replace-with-at-least-32-random-characters

# ===== Frontend / Expo =====
# スマホ実機で確認する場合は、自分のPCのローカルIPに変更する
LOCAL_IP=192.168.x.x
EXPO_PUBLIC_API_URL=http://192.168.x.x:8080
